# Minimal decontented build for ARK_FPV / Foxeer F405v2
# Based on Andy's SmallFastDrone-4.6 branch
# Keep only essential copter features

# Enable the compass that ARK_FPV uses
define AP_COMPASS_IIS2MDC_ENABLED 1

# Enable only essential RC protocols (SBUS, CRSF for typical FPV use)
define AP_RCPROTOCOL_ENABLED 1
define AP_RCPROTOCOL_SBUS_ENABLED 1
define AP_RCPROTOCOL_CRSF_ENABLED 1

# Enable only UBLOX GPS (most common)
define AP_GPS_UBLOX_ENABLED 1

# Enable only needed baro (ICP101XX is on ARK_FPV)
define AP_BARO_ICP101XX_ENABLED 1

# Keep essential flight modes only
define MODE_ACRO_ENABLED 1
define MODE_STABILIZE_ENABLED 1
define MODE_ALTHOLD_ENABLED 1
define MODE_LOITER_ENABLED 1
define MODE_AUTO_ENABLED 1
define MODE_GUIDED_ENABLED 1
define MODE_RTL_ENABLED 1
define MODE_LAND_ENABLED 1
define MODE_POSHOLD_ENABLED 1
define AP_MOTORS_FRAME_QUAD_ENABLED 1

# Enable ESC telemetry (common on FPV quads)
define HAL_WITH_ESC_TELEM 1

# Enable essential telemetry (MSP for goggles, CRSF bidirectional)
define HAL_MSP_ENABLED 1
define HAL_WITH_MSP_DISPLAYPORT 1
define HAL_CRSF_TELEM_ENABLED 1

# Enable OSD (essential for FPV)
define OSD_ENABLED 1

# Enable logging
define HAL_LOGGING_ENABLED 1

# Enable basic mavlink features
define AP_MAVLINK_FTP_ENABLED 0
define HAL_HIGH_LATENCY2_ENABLED 0

# Disable unused features
undef HAL_EXTERNAL_AHRS_ENABLED
undef HAL_NAVEKF2_AVAILABLE
undef EK3_FEATURE_EXTERNAL_NAV
undef EK3_FEATURE_OPTFLOW_FUSION
undef HAL_MOUNT_ENABLED
undef HAL_SPRAYER_ENABLED
undef AP_CAMERA_ENABLED
undef HAL_SOLO_GIMBAL_ENABLED
undef AC_PRECLAND_ENABLED
undef HAL_PROXIMITY_ENABLED
undef AP_RANGEFINDER_ENABLED
undef AP_GRIPPER_ENABLED
undef AP_WINCH_ENABLED
undef AP_LANDINGGEAR_ENABLED
undef HAL_PARACHUTE_ENABLED
undef HAL_GENERATOR_ENABLED
undef AP_ICENGINE_ENABLED
undef HAL_EFI_ENABLED
undef AP_OPTICALFLOW_ENABLED
undef AP_BEACON_ENABLED
undef HAL_ADSB_ENABLED
undef AP_AIS_ENABLED
undef AP_OPENDRONEID_ENABLED
undef HAL_QUADPLANE_ENABLED
undef HAL_SOARING_ENABLED
undef AP_PLANE_BLACKBOX_LOGGING
undef AP_AVOIDANCE_ENABLED
undef AP_OAPATHPLANNER_ENABLED
undef AP_SCRIPTING_ENABLED
undef HAL_TORQEEDO_ENABLED
undef HAL_DISPLAY_ENABLED
undef HAL_NMEA_OUTPUT_ENABLED

# Disable unused motor frames
undef AP_MOTORS_FRAME_HEXA_ENABLED
undef AP_MOTORS_FRAME_OCTA_ENABLED
undef AP_MOTORS_FRAME_OCTAQUAD_ENABLED
undef AP_MOTORS_FRAME_Y6_ENABLED
undef AP_MOTORS_FRAME_DECA_ENABLED
undef AP_MOTORS_FRAME_DODECAHEXA_ENABLED

# Disable unused modes
undef MODE_FLIP_ENABLED
undef MODE_TURTLE_ENABLED
undef MODE_SPORT_ENABLED
undef MODE_DRIFT_ENABLED
undef MODE_FOLLOW_ENABLED
undef MODE_ZIGZAG_ENABLED
undef MODE_SYSTEMID_ENABLED
undef MODE_AUTOROTATE_ENABLED
undef MODE_FLOWHOLD_ENABLED
undef MODE_CIRCLE_ENABLED
undef MODE_BRAKE_ENABLED

# Disable advanced features
undef AP_COPTER_ADVANCED_FAILSAFE_ENABLED
undef AP_ADVANCEDFAILSAFE_ENABLED
undef AP_FENCE_ENABLED
undef HAL_RALLY_ENABLED
undef AP_AIRSPEED_ENABLED
undef COMPASS_CAL_ENABLED
undef AC_PAYLOAD_PLACE_ENABLED

# Disable unused telemetry  
undef AP_FRSKY_TELEM_ENABLED
undef HAL_HOTT_TELEM_ENABLED
undef AP_LTM_TELEM_ENABLED
undef HAL_SPEKTRUM_TELEM_ENABLED
undef AP_IBUS_TELEM_ENABLED

# Disable video TX control (can re-enable if needed)
undef AP_SMARTAUDIO_ENABLED
undef AP_TRAMP_ENABLED
undef AP_VIDEOTX_ENABLED

# Disable FFT/gyro logging (can re-enable if needed for tuning)
undef HAL_GYROFFT_ENABLED
undef AP_INERTIALSENSOR_BATCHSAMPLER_ENABLED

# Disable DroneCAN (not needed for basic FPV quad, saves flash)
undef HAL_ENABLE_DRONECAN_DRIVERS
