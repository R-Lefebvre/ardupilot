# Minimal decontented build for FoxeerF405v2
# Based on Andy's SmallFastDrone-4.6 branch
# Keep only essential copter features

# FoxeerF405v2 uses DPS280 baro (also supports BMP280 and SPL06)
define AP_BARO_DPS280_ENABLED 1
define AP_BARO_BMP280_ENABLED 1
define AP_BARO_SPL06_ENABLED 1

# Allow no compass (external compass optional on FoxeerF405v2)
define HAL_PROBE_EXTERNAL_I2C_COMPASSES 1

# Enable only essential RC protocols (SBUS, CRSF for typical FPV use)
define AP_RCPROTOCOL_ENABLED 1
define AP_RCPROTOCOL_SBUS_ENABLED 1
define AP_RCPROTOCOL_CRSF_ENABLED 1

# Enable only UBLOX GPS (most common)
define AP_GPS_UBLOX_ENABLED 1

# Keep essential flight modes only
define MODE_ACRO_ENABLED 1
define MODE_STABILIZE_ENABLED 1
define MODE_ALTHOLD_ENABLED 1
define MODE_LOITER_ENABLED 1
define MODE_AUTO_ENABLED 1
define MODE_GUIDED_ENABLED 1
define MODE_RTL_ENABLED 1
define MODE_LAND_ENABLED 1
define MODE_POSHOLD_ENABLED 1
define AP_MOTORS_FRAME_QUAD_ENABLED 1

# Enable ESC telemetry (common on FPV quads)
define HAL_WITH_ESC_TELEM 1

# Enable essential telemetry (MSP for goggles, CRSF bidirectional)
define HAL_MSP_ENABLED 1
define HAL_WITH_MSP_DISPLAYPORT 1
define HAL_CRSF_TELEM_ENABLED 1

# Enable OSD (essential for FPV)
define OSD_ENABLED 1

# Enable logging
define HAL_LOGGING_ENABLED 1

# Disable unused features (use define X 0, not undef)
define HAL_EXTERNAL_AHRS_ENABLED 0
define HAL_NAVEKF2_AVAILABLE 0
define EK3_FEATURE_EXTERNAL_NAV 0
define EK3_FEATURE_OPTFLOW_FUSION 0
define HAL_MOUNT_ENABLED 0
define HAL_SPRAYER_ENABLED 0
define AP_CAMERA_ENABLED 0
define HAL_SOLO_GIMBAL_ENABLED 0
define AC_PRECLAND_ENABLED 0
define HAL_PROXIMITY_ENABLED 0
define AP_RANGEFINDER_ENABLED 0
define AP_GRIPPER_ENABLED 0
define AP_WINCH_ENABLED 0
define AP_LANDINGGEAR_ENABLED 0
define HAL_PARACHUTE_ENABLED 0
define HAL_GENERATOR_ENABLED 0
define AP_ICENGINE_ENABLED 0
define HAL_EFI_ENABLED 0
define AP_OPTICALFLOW_ENABLED 0
define AP_BEACON_ENABLED 0
define HAL_ADSB_ENABLED 0
define AP_AIS_ENABLED 0
define AP_OPENDRONEID_ENABLED 0
define HAL_QUADPLANE_ENABLED 0
define HAL_SOARING_ENABLED 0
define AP_AVOIDANCE_ENABLED 0
define AP_OAPATHPLANNER_ENABLED 0
define AP_SCRIPTING_ENABLED 0
define HAL_TORQEEDO_ENABLED 0
define HAL_DISPLAY_ENABLED 0
define HAL_NMEA_OUTPUT_ENABLED 0
define AP_MAVLINK_FTP_ENABLED 0
define HAL_HIGH_LATENCY2_ENABLED 0

# Disable unused motor frames
define AP_MOTORS_FRAME_HEXA_ENABLED 0
define AP_MOTORS_FRAME_OCTA_ENABLED 0
define AP_MOTORS_FRAME_OCTAQUAD_ENABLED 0
define AP_MOTORS_FRAME_Y6_ENABLED 0
define AP_MOTORS_FRAME_DECA_ENABLED 0
define AP_MOTORS_FRAME_DODECAHEXA_ENABLED 0

# Disable unused modes
define MODE_FLIP_ENABLED 0
define MODE_TURTLE_ENABLED 0
define MODE_SPORT_ENABLED 0
define MODE_DRIFT_ENABLED 0
define MODE_FOLLOW_ENABLED 0
define MODE_ZIGZAG_ENABLED 0
define MODE_SYSTEMID_ENABLED 0
define MODE_AUTOROTATE_ENABLED 0
define MODE_FLOWHOLD_ENABLED 0
# define MODE_CIRCLE_ENABLED 0  # Required by Auto mode
define MODE_BRAKE_ENABLED 0

# Disable advanced features
define AP_COPTER_ADVANCED_FAILSAFE_ENABLED 0
define AP_ADVANCEDFAILSAFE_ENABLED 0
define AP_FENCE_ENABLED 0
define HAL_RALLY_ENABLED 0
define AP_AIRSPEED_ENABLED 0
define AC_PAYLOAD_PLACE_ENABLED 0

# Disable unused telemetry (keep FrSky for CRSF passthrough)
# define AP_FRSKY_TELEM_ENABLED 0  # Needed for CRSF passthrough
define HAL_HOTT_TELEM_ENABLED 0
define AP_LTM_TELEM_ENABLED 0
define HAL_SPEKTRUM_TELEM_ENABLED 0
define AP_IBUS_TELEM_ENABLED 0

# Disable video TX control
define AP_SMARTAUDIO_ENABLED 0
define AP_TRAMP_ENABLED 0
define AP_VIDEOTX_ENABLED 0

# Disable FFT/gyro logging (can re-enable if needed for tuning)
define HAL_GYROFFT_ENABLED 0
define AP_INERTIALSENSOR_BATCHSAMPLER_ENABLED 0

# Disable DroneCAN drivers (CAN hardware stays enabled but no DroneCAN protocol)
define HAL_ENABLE_DRONECAN_DRIVERS 0
